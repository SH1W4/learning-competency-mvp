{
  "name": "learning-competency-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Learning Competency MVP — vertical slice completo: evidência → IA → revisão humana → estado → atestação Solana → verificação",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo": "tsx src/cli/demo.ts",
    "demo:revisao-parcial": "tsx src/cli/demo.ts --review fixtures/synthetic/ana/review_request_more.json",
    "m3:attest": "tsx src/solana/demo.ts",
    "m3:verify": "tsx src/solana/verify.ts",
    "test:solana:devnet": "tsx src/solana/integration.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "dotenv": "^18.0.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
